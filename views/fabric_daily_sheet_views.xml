<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fabric_daily_sheet_tree" model="ir.ui.view">
        <field name="name">fabric.daily.sheet.tree</field>
        <field name="model">fabric.daily.sheet</field>
        <field name="arch" type="xml">
            <list string="Daily Sales Sheets" decoration-info="create_uid == uid">
                <field name="create_uid" string="Creator" readonly="1" widget="many2one_avatar_user" optional="show"/>
                <field name="date"/>
                <field name="last_balance"/>
                <field name="total_sale"/>
                <field name="total_cashin"/>
                <field name="sub_total"/>
                <field name="total_cashout"/>
                <field name="total_shopexp"/>
                <field name="total_homeexp"/>
                <field name="current_day_balance"/>
            </list>
        </field>
    </record>

    <record id="view_fabric_daily_sheet_form" model="ir.ui.view">
        <field name="name">fabric.daily.sheet.form</field>
        <field name="model">fabric.daily.sheet</field>
        <field name="arch" type="xml">
            <form string="Daily Sale Sheet Record">
                <sheet>
                    <div class="mb-3 w-100 p-0 m-0">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="last_balance"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sale Entries">
                            <field name="sale_line_ids">
                                <list editable="bottom" decoration-info="create_uid == uid">
                                    <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="customer_id"/>
                                    <field name="customer_name"/>
                                    <field name="roll_qty"/>
                                    <field name="qty"/>
                                    <field name="item_name"/>
                                    <field name="unit"/>
                                    <field name="price_per_unit"/>
                                    <field name="total_price"/>
                                    <field name="note"/>
                                    <field name="is_unpaid"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cash In Entries">
                            <field name="cashin_line_ids">
                                <list editable="bottom" decoration-info="create_uid == uid">
                                    <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="customer_id"/>
                                    <field name="customer_name"/>
                                    <field name="note"/>
                                    <field name="money"/>
                                    <field name="is_khata"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cash Out Entries">
                            <field name="cashout_line_ids">
                                <list editable="bottom" decoration-info="create_uid == uid">
                                    <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="customer_id"/>
                                    <field name="customer_name"/>
                                    <field name="note"/>
                                    <field name="money"/>
                                    <field name="is_khata"/>
                                </list>
                            </field>
                        </page>
                        <page string="Shop Expenses">
                            <field name="shopexp_line_ids">
                                <list editable="bottom" decoration-info="create_uid == uid">
                                    <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="note"/>
                                    <field name="money"/>
                                </list>
                            </field>
                        </page>
                        <page string="Home Expenses">
                            <field name="homeexp_line_ids">
                                <list editable="bottom" decoration-info="create_uid == uid">
                                    <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" optional="show"/>
                                    <field name="sequence"/>
                                    <field name="note"/>
                                    <field name="money"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- FINAL CALCULATION SUMMARY -->
                    <group class="oe_subtotal_footer oe_right">
                        <field name="last_balance"/>
                        <field name="total_sale"/>
                        <field name="total_cashin"/>
                        <field name="sub_total" class="oe_subtotal_footer_separator"/>
                        <field name="total_cashout"/>
                        <field name="total_shopexp"/>
                        <field name="total_homeexp"/>
                        <field name="current_day_balance" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fabric_daily_sheet" model="ir.actions.act_window">
        <field name="name">Daily Sales Sheets Records</field>
        <field name="res_model">fabric.daily.sheet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
