<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fabric Unit List View -->
    <record id="view_fabric_unit_list" model="ir.ui.view">
        <field name="name">fabric.unit.list</field>
        <field name="model">fabric.unit</field>
        <field name="arch" type="xml">
            <list string="Fabric Units" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Unit Name"/>
                <field name="code" string="Code / Abbr"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Fabric Unit Form View -->
    <record id="view_fabric_unit_form" model="ir.ui.view">
        <field name="name">fabric.unit.form</field>
        <field name="model">fabric.unit</field>
        <field name="arch" type="xml">
            <form string="Fabric Unit">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Unit Name"/>
                        <h1><field name="name" placeholder="e.g. Meter, Yard, Roll, Piece, Kg"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. M, YD, ROLL, PC"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fabric Unit Search View -->
    <record id="view_fabric_unit_search" model="ir.ui.view">
        <field name="name">fabric.unit.search</field>
        <field name="model">fabric.unit</field>
        <field name="arch" type="xml">
            <search string="Search Units">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action for Fabric Unit -->
    <record id="action_fabric_unit" model="ir.actions.act_window">
        <field name="name">Units Master</field>
        <field name="res_model">fabric.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fabric_unit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your measurement units (e.g., Meter, Yard, Roll, Piece, Kg).
            </p>
        </field>
    </record>
</odoo>
