<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CLIENT ACTIONS FOR CUSTOM INTERACTIVE DASHBOARD -->
    <record id="action_fabric_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">fabric_erp.dashboard</field>
    </record>

    <!-- CUSTOMER KHATA DIRECTORY LIST VIEW (Screenshot 3) -->
    <record id="view_fabric_customer_tree" model="ir.ui.view">
        <field name="name">fabric.customer.tree</field>
        <field name="model">fabric.customer</field>
        <field name="arch" type="xml">
            <list string="Customer Khata Accounts Directory" default_order="id asc" limit="1000">
                <field name="currency_id" column_invisible="1"/>
                <field name="code"/>
                <field name="name" string="Customer Name &amp; Contact"/>
                <field name="phone"/>

                <field name="paid_amount" string="Total Cash In (Jama)" widget="fabric_amount" sum="Total Cash In"/>
                <field name="total_sales" string="Total Cash Out (Udhaar)" widget="fabric_amount" sum="Total Cash Out"/>
                <field name="current_net_balance" string="Current Udhar Balance" widget="fabric_amount" sum="Total Udhar Balance" decoration-danger="current_net_balance &lt; 0" decoration-success="current_net_balance &gt; 0"/>
                <field name="status" widget="badge" decoration-danger="status == 'udhaar_due'" decoration-success="status == 'clear'"/>
                <button name="action_view_ledger" string="View Form ›" type="object" class="btn-outline-primary btn-sm"/>
            </list>
        </field>
    </record>

    <!-- CUSTOMER SEARCH FILTERS -->
    <record id="view_fabric_customer_search" model="ir.ui.view">
        <field name="name">fabric.customer.search</field>
        <field name="model">fabric.customer</field>
        <field name="arch" type="xml">
            <search string="Search Khata Customers">
                <field name="name"/>
                <field name="phone"/>

                <filter string="Udhaar Due Only" name="filter_udhaar_due" domain="[('status', '=', 'udhaar_due')]"/>
                <filter string="Clear Accounts" name="filter_clear" domain="[('status', '=', 'clear')]"/>
                <group expand="0" string="Group By">

                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- CUSTOMER KHATA INDIVIDUAL LEDGER FORM VIEW (Screenshot 4) -->
    <record id="view_fabric_customer_form" model="ir.ui.view">
        <field name="name">fabric.customer.form</field>
        <field name="model">fabric.customer</field>
        <field name="arch" type="xml">
            <form string="Customer Khata Ledger">
                <header>
                    <button name="%(fabric_erp.action_fabric_dashboard)d" string="Back to Dashboard" type="action" class="btn-info" icon="fa-arrow-left"/>
                    <button name="action_share_whatsapp" string="Share WA" type="object" class="btn-success" icon="fa-whatsapp"/>
                    <button name="action_give_udhaar_dialog" string="+ Give Udhaar" type="object" class="btn-secondary"/>
                    <button name="action_record_jama_dialog" string="+ Record Jama Payment" type="object" class="btn-primary"/>
                    <field name="status" widget="statusbar" statusbar_visible="clear,udhaar_due"/>
                </header>
                <sheet>
                    <!-- UNIQUE MODERN CUSTOMER COMMAND HERO -->
                    <div class="fabric-customer-hero-header mb-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-secondary-subtle text-secondary fw-bold px-2 py-1" style="font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">Customer Khata</span>
                                    <span class="text-muted small">•</span>
                                    <span class="text-muted small"><i class="fa fa-id-badge text-primary me-1" title="Customer ID"></i><field name="code"/></span>
                                    <span class="text-muted small">•</span>
                                    <span class="text-muted small"><i class="fa fa-phone text-success me-1" title="Phone"></i><field name="phone"/></span>
                                </div>
                                <h1 class="fw-bold text-dark m-0" style="font-size: 1.85rem; letter-spacing: -0.02em;">
                                    <field name="name" placeholder="Customer / Store Name"/>
                                </h1>
                            </div>
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <!-- QUICK BALANCE CAPSULE -->
                                <div class="fabric-quick-balance-pill" decoration-danger="current_net_balance &lt; 0" decoration-success="current_net_balance &gt;= 0">
                                    <span class="quick-balance-dot"></span>
                                    <span class="quick-balance-label">Net Due:</span>
                                    <span class="quick-balance-val"><field name="current_net_balance" widget="fabric_amount"/></span>
                                </div>
                                <!-- SUMMARY DRAWER TRIGGER BUTTON -->
                                <span role="button" class="fabric-pill-btn-unique fabric-toggle-summary-btn" title="Open Financial Summary &amp; Profile">
                                    <i class="fa fa-sliders text-primary" title="Summary Toggle"></i>
                                    <span class="summary-btn-text">Summary</span>
                                    <i class="fa fa-chevron-right ms-1 summary-btn-arrow" title="Open Drawer"></i>
                                </span>
                                <!-- CHATTER DRAWER TRIGGER BUTTON -->
                                <span role="button" class="fabric-pill-btn-unique fabric-chatter-shortcut-btn" title="Open Activity &amp; Chatter Drawer">
                                    <i class="fa fa-comments-o text-primary" title="Chatter Shortcut"></i>
                                    <span class="chatter-btn-text">Chatter</span>
                                    <i class="fa fa-chevron-right ms-1 chatter-btn-arrow" title="Open Drawer"></i>
                                </span>
                            </div>
                        </div>

                        <!-- SLIDE-OVER INSPECTOR DRAWER: FINANCIAL SUMMARY (MOBILE & LAPTOP OPTIMIZED) -->
                        <div class="fabric-slide-drawer fabric-summary-drawer">
                            <div class="summary-card-accent"></div>
                            <div class="drawer-header-bar d-flex justify-content-between align-items-center p-3 border-bottom bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="drawer-header-icon-box">
                                        <i class="fa fa-bar-chart text-primary" title="Overview"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark m-0" style="font-size: 1.05rem;">FINANCIAL SUMMARY &amp; PROFILE</h5>
                                        <span class="text-muted small">
                                            <i class="fa fa-clock-o me-1" title="Time"></i>Last Active: <field name="last_activity_date"/>
                                        </span>
                                    </div>
                                </div>
                                <span role="button" class="fabric-drawer-close-btn" title="Close Drawer">&#215;</span>
                            </div>

                            <div class="drawer-body-scroll p-3">
                                <!-- 3 KPI BENTO CARDS -->
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="bento-kpi-card bento-jama">
                                            <div class="bento-kpi-header">
                                                <span class="bento-kpi-icon"><i class="fa fa-arrow-down" title="Cash In"></i></span>
                                                <span class="bento-kpi-title">TOTAL CASH IN (JAMA)</span>
                                            </div>
                                            <div class="bento-kpi-value text-success">
                                                <field name="paid_amount" widget="fabric_amount"/>
                                            </div>
                                            <div class="bento-kpi-sub">Total Payments Received</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="bento-kpi-card bento-udhaar">
                                            <div class="bento-kpi-header">
                                                <span class="bento-kpi-icon"><i class="fa fa-arrow-up" title="Cash Out"></i></span>
                                                <span class="bento-kpi-title">TOTAL CASH OUT (UDHAAR)</span>
                                            </div>
                                            <div class="bento-kpi-value text-dark">
                                                <field name="total_sales" widget="fabric_amount"/>
                                            </div>
                                            <div class="bento-kpi-sub">Total Fabric Sales Billed</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="bento-kpi-card bento-net" decoration-danger="current_net_balance &lt; 0" decoration-success="current_net_balance &gt; 0">
                                            <div class="bento-kpi-header">
                                                <span class="bento-kpi-icon"><i class="fa fa-balance-scale" title="Balance"></i></span>
                                                <span class="bento-kpi-title">CURRENT UDHAR BALANCE</span>
                                            </div>
                                            <div class="bento-kpi-value">
                                                <field name="current_net_balance" widget="fabric_amount"/>
                                            </div>
                                            <div class="bento-kpi-sub">Net Outstanding Position</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- CUSTOMER DETAILS CARD -->
                                <div class="card border-0 bg-light p-3 mt-3 rounded-3">
                                    <h6 class="fw-bold text-dark mb-2">
                                        <i class="fa fa-address-card-o me-2 text-primary" title="Details"></i>Customer Contact Details
                                    </h6>
                                    <div class="mb-2 text-muted small">
                                        <i class="fa fa-map-marker text-danger me-2" title="Address"></i><strong>Store Address:</strong>
                                        <div class="mt-1 ps-3 text-dark"><field name="store_address"/></div>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fa fa-phone text-success me-2" title="Phone"></i><strong>Contact Phone:</strong>
                                        <span class="text-dark ms-1"><field name="phone"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- COMPLETE TRANSACTION LEDGER STATEMENT TABLE -->
                    <div class="mt-4">
                        <h4 class="fw-bold mb-3">
                            <i class="fa fa-list-alt me-2 text-primary"></i>COMPLETE TRANSACTION LEDGER STATEMENT
                        </h4>
                        <field name="transaction_ids">
                            <list string="Transactions" create="0" delete="0" default_order="date asc, id asc" limit="10000">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="display_date"/>
                                <field name="entry_type" widget="badge" decoration-success="entry_type == 'jama'" decoration-danger="entry_type == 'udhaar'"/>
                                <field name="particulars"/>
                                <field name="payment_method"/>
                                <field name="cash_in" string="Cash In (Jama)" widget="fabric_amount" sum="Total Cash In" decoration-success="cash_in &gt; 0" decoration-muted="cash_in == 0"/>
                                <field name="cash_out" string="Cash Out (Udhaar)" widget="fabric_amount" sum="Total Cash Out" decoration-danger="cash_out &gt; 0" decoration-muted="cash_out == 0"/>
                                <field name="running_balance" string="Udhar / Net Balance" sum="Total Udhar Balance" widget="fabric_amount" decoration-danger="running_balance &lt; 0" decoration-success="running_balance &gt; 0"/>
                                <button name="action_open_transaction" type="object" icon="fa-external-link" string="Open" title="Open Transaction Details"/>
                                <button name="action_delete_transaction" type="object" icon="fa-trash text-danger" title="Delete Entry" confirm="Are you sure you want to delete this transaction entry? This will update the customer balance."/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- TRANSACTION WIZARD FORM VIEW -->
    <record id="view_fabric_khata_transaction_wizard_form" model="ir.ui.view">
        <field name="name">fabric.khata.transaction.wizard.form</field>
        <field name="model">fabric.khata.transaction.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Transaction Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="entry_type" required="1"/>
                            <field name="date" required="1"/>
                        </group>
                        <group>
                            <field name="amount" required="1" widget="fabric_amount"/>
                            <field name="payment_method" required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="particulars" placeholder="e.g. Bill #DS-2026-101 Credit Udhaar balance / Cash Payment"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_transaction" string="Save Transaction" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
    <!-- KHATA TRANSACTION FORM VIEW -->
    <record id="view_fabric_khata_transaction_form" model="ir.ui.view">
        <field name="name">fabric.khata.transaction.form</field>
        <field name="model">fabric.khata.transaction</field>
        <field name="arch" type="xml">
            <form string="Khata Transaction">
                <header>
                    <button name="action_delete_transaction" string="Delete Entry" type="object" class="btn-outline-danger" icon="fa-trash" confirm="Are you sure you want to delete this transaction entry? This will update the customer balance."/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="entry_type"/>
                            <field name="date" required="1"/>
                        </group>
                        <group>
                            <field name="amount" widget="fabric_amount"/>
                            <field name="cash_in" widget="fabric_amount" readonly="1"/>
                            <field name="cash_out" widget="fabric_amount" readonly="1"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <group>
                        <field name="particulars"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KHATA TRANSACTION TREE / LIST VIEW -->
    <record id="view_fabric_khata_transaction_tree" model="ir.ui.view">
        <field name="name">fabric.khata.transaction.tree</field>
        <field name="model">fabric.khata.transaction</field>
        <field name="arch" type="xml">
            <list string="Khata Transactions" default_order="date desc, id desc" delete="0" limit="10000">
                <field name="currency_id" column_invisible="1"/>
                <field name="display_date"/>
                <field name="customer_id"/>
                <field name="entry_type" widget="badge" decoration-success="entry_type == 'jama'" decoration-danger="entry_type == 'udhaar'"/>
                <field name="particulars"/>
                <field name="payment_method"/>
                <field name="cash_in" string="Cash In (Jama)" widget="fabric_amount" sum="Total Cash In" decoration-success="cash_in &gt; 0" decoration-muted="cash_in == 0"/>
                <field name="cash_out" string="Cash Out (Udhaar)" widget="fabric_amount" sum="Total Cash Out" decoration-danger="cash_out &gt; 0" decoration-muted="cash_out == 0"/>
                <field name="running_balance" string="Udhar / Net Balance" sum="Total Udhar Balance" widget="fabric_amount" decoration-danger="running_balance &lt; 0" decoration-success="running_balance &gt; 0"/>
                <button name="action_delete_transaction" type="object" icon="fa-trash text-danger" title="Delete Entry" confirm="Are you sure you want to delete this transaction entry? This will update the customer balance."/>
            </list>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_fabric_customer" model="ir.actions.act_window">
        <field name="name">Customer Khata Accounts Directory</field>
        <field name="res_model">fabric.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fabric_customer_search"/>
    </record>

    <record id="action_fabric_khata_transaction" model="ir.actions.act_window">
        <field name="name">Khata Transactions</field>
        <field name="res_model">fabric.khata.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
