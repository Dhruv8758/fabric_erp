<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category for Aaradhya Fabric ERP -->
        <record id="module_category_aaradhya_fabric" model="ir.module.category">
            <field name="name">Aaradhya Fabric</field>
            <field name="description">Helps you manage your Aaradhya Fabric ERP operations.</field>
            <field name="sequence">10</field>
        </record>

        <!-- User Group -->
        <record id="group_fabric_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_aaradhya_fabric"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_fabric_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_aaradhya_fabric"/>
            <field name="implied_ids" eval="[(4, ref('group_fabric_user'))]"/>
        </record>

        <!-- Admin Group -->
        <record id="group_fabric_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_aaradhya_fabric"/>
            <field name="implied_ids" eval="[(4, ref('group_fabric_manager'))]"/>
        </record>
        <record id="rule_fabric_customer_comp" model="ir.rule">
            <field name="name">Fabric Customer multi-company</field>
            <field name="model_id" ref="model_fabric_customer"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
